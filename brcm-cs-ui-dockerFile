RUN npm run build:$envtype

WORKDIR /usr/src/app

RUN mkdir -p /usr/src/app/web/public/navigation/

#RUN mkdir -p /var/www/html/
#RUN touch /var/www/html/test.txt
RUN chmod a+rwx /var/www/html/
RUN chmod a+rwx /usr/src/app/web/
RUN chmod a+rwx /usr/src/app/web/public/img/
RUN chmod a+rwx /usr/src/app/web/public/navigation/

RUN wget https://github.com/Droplr/aws-env/raw/master/bin/aws-env-linux-amd64 -O /bin/aws-env && chmod +x /bin/aws-env

CMD eval $(/bin/aws-env); /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
