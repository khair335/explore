	    return 301 https://$http_host$request_uri?pid=sep14;
	}
	# ID : 188877 - Sunset Okta login and myBroadcom
	if ($request_uri = "/mybroadcom/login"){
        return 301 https://support.broadcom.com/user;
    }
    if ($request_uri = "/mybroadcom/login/"){
        return 301 https://support.broadcom.com/user;
    }
    if ($request_uri = "/mybroadcom"){
        return 301 https://support.broadcom.com;
    }
    rewrite ^/mybroadcom/login/(.*) https://support.broadcom.com/user permanent;
    rewrite ^/mybroadcom/login?(.*) https://support.broadcom.com/user permanent;
    rewrite ^/mybroadcom/logout https://login.broadcom.com/login/signout permanent;
    rewrite ^/mybroadcom/(.*) https://support.broadcom.com permanent;

    if ($request_uri = "/mybroadcom"){
        return 301 https://support.broadcom.com;
    }

    location /docs/ {
        if ($vmdomain = 0) {
             return 301 https://DOCS-DOMAIN.broadcom.com$request_uri;
        }
		include /etc/nginx/redirects/vm-docs-proxying.conf;
	}

	if ($http_x_forwarded_proto = "http") {
      	  return 301 https://$http_host$request_uri;
  	}

	include /etc/nginx/redirects/redirects_AVAGO.conf;
	include /etc/nginx/redirects/redirects_vmware.conf;
	include /etc/nginx/redirects/proxying.conf;
	include /etc/nginx/redirects/vmware-acs-redirects.conf;
	#include /etc/nginx/redirects/redirects_limelight_to_brightcove.conf;
	include /etc/nginx/redirects/vmdocs-proxy.conf;

}

