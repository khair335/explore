
server {

  listen 80 ;
  listen [::]:80;
  auth_basic $authdynamic;
  auth_basic_user_file /etc/nginx/.htpasswd;
  root /var/www/html;
  index index.html index.htm index.nginx-debian.html;
  #server_name $brcmdocsserver;
  server_name brcm-cs-dev-docs.aws.broadcom.com
              brcm-cs-qa-docs.aws.broadcom.com
              brcm-cs-stg-docs.aws.broadcom.com
              brcm-cs-prd-docs.aws.broadcom.com
              brcm-cs-dr-docs.aws.broadcom.com
              docscmsstaging.aws.broadcom.com
              docscmsstaging.broadcom.com
              docs.broadcom.com;
  if ($http_x_forwarded_proto = "http") {
    return 301 https://$server_name$request_uri;
  }

  # Adding redirect as part of Ticket 195762

  rewrite ^/docs/12395293 https://$http_host/docs/Broadcom-Statement-Against-Modern-Slavery-and-Human-Trafficking permanent;
  rewrite ^/docs/12395293/ https://$http_host/docs/Broadcom-Statement-Against-Modern-Slavery-and-Human-Trafficking permanent;

  rewrite ^/doc/12395293 https://$http_host/doc/Broadcom-Statement-Against-Modern-Slavery-and-Human-Trafficking permanent;
  rewrite ^/doc/12395293/ https://$http_host/doc/Broadcom-Statement-Against-Modern-Slavery-and-Human-Trafficking permanent;

  rewrite ^/docs/GA-MX-460-07 https://$http_host/docs/GA-MX-460 permanent;
  rewrite ^/docs/GA-MX-460-07/ https://$http_host/docs/GA-MX-460 permanent;

  rewrite ^/doc/GA-MX-460-07 https://$http_host/doc/GA-MX-460 permanent;
  rewrite ^/doc/GA-MX-460-07/ https://$http_host/doc/GA-MX-460 permanent;

  access_log /dev/stdout;
  error_log  /dev/stderr;
  rewrite_log on;
  include /etc/nginx/redirects/docs-proxying.conf;

}


